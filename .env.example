# ─────────────────────────────────────────────────────────────────────────────
# .env.example — EntityKart Monolith
# Copy this file to .env for local development (never commit .env to git!)
# On Render: set these as Environment Variables in the dashboard (not a file).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# Local development:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=entitykart_database
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_USE_SSL=false

# Aiven Cloud MySQL (use these on Render):
# DB_HOST=entitkart-mdsadiqueamin721786-entitykart.a.aivencloud.com
# DB_PORT=20904
# DB_NAME=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_USE_SSL=true   ← REQUIRED for Aiven (SSL is enforced)

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate strong secrets with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (future integration — not yet wired up) ────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Authorize.Net ───────────────────────────────────────────────────────────
AUTHORIZE_NET_API_LOGIN_ID=your_login_id
AUTHORIZE_NET_TRANSACTION_KEY=your_transaction_key
AUTHORIZE_NET_ENVIRONMENT=sandbox

# ─── Twilio (future integration — not yet wired up) ──────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── Gmail SMTP ──────────────────────────────────────────────────────────────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password   # 16-char App Password, NOT your account password

# ─── App URLs ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@entitykart.com

# Local development:
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Render production (replace with your actual Render service URL):
# APP_URL=https://entitykart-monolith.onrender.com
# CORS_ALLOWED_ORIGINS=https://entitykart-monolith.onrender.com

# ─── Render Platform ─────────────────────────────────────────────────────────
# PORT is automatically injected by Render — do NOT set this manually on Render.
# For local development only (app defaults to 8080 if PORT is not set):
# PORT=8080
